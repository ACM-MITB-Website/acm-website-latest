# ============================================================
# Firebase Client SDK Configuration
# ============================================================
# SECURITY NOTE: Firebase client-side keys (apiKey, appId, etc.) are
# intentionally designed to be public — they identify your Firebase
# project but do NOT grant administrative access. Security is enforced
# entirely by Firebase Security Rules (firestore.rules / storage.rules).
# See: https://firebase.google.com/docs/projects/api-keys
# You MUST still restrict these keys in the Google Cloud Console:
#   → APIs & Services → Credentials → restrict by HTTP Referrer/API
VITE_FIREBASE_API_KEY=your_api_key
VITE_FIREBASE_AUTH_DOMAIN=your_project.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=your_project_id
VITE_FIREBASE_STORAGE_BUCKET=your_project.appspot.com
VITE_FIREBASE_MESSAGING_SENDER_ID=your_sender_id
VITE_FIREBASE_APP_ID=your_app_id
VITE_FIREBASE_MEASUREMENT_ID=your_measurement_id

# reCAPTCHA v3 Site Key — intentionally public, safe to expose client-side
VITE_RECAPTCHA_SITE_KEY=your_recaptcha_v3_site_key

# ============================================================
# Cloudinary — PUBLIC identifiers only (safe in VITE_ prefix)
# ============================================================
# The cloud name is a public identifier; safe to embed in client bundles.
VITE_CLOUDINARY_CLOUD_NAME=your_cloud_name

# ============================================================
# Cloudinary — SERVER-SIDE SECRETS (NEVER prefix with VITE_)
# ============================================================
# SECURITY: These variables are used ONLY by the Vercel serverless function
# at /api/upload-image.js. They must NEVER be prefixed with VITE_ or they
# will be bundled into the client JavaScript and exposed to all visitors.
#
# Set these in the Vercel dashboard under:
#   Project → Settings → Environment Variables
# Do NOT commit actual values. Never put real values in this file.
CLOUDINARY_API_KEY=your_cloudinary_api_key
CLOUDINARY_API_SECRET=your_cloudinary_api_secret
CLOUDINARY_UPLOAD_PRESET=your_upload_preset_name
