rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return signedIn() && request.auth.uid == userId;
    }

    function isAdmin() {
      return signedIn() && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.townhall == true;
    }

    // User profiles: users can only read/write their own document
    match /users/{userId} {
      allow read: if isOwner(userId) || isAdmin();

      allow create: if isOwner(userId)
        && request.resource.data.townhall == false;

      allow update: if isOwner(userId)
        && request.resource.data.townhall == resource.data.townhall;

      allow delete: if isAdmin();
    }

    // Events: public read, townhall-only writes
    match /events/{eventId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // Membership applications: user create, townhall read/write
    match /applications/{appId} {
      allow create: if signedIn();
      allow read, update, delete: if isAdmin();
    }

    // Townhall-only pages/collections should be stored here
    match /adminData/{docId} {
      allow read, write: if isAdmin();
    }

    // Default: deny anything else
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
